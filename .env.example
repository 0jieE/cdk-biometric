SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL connection
DB_NAME=attendance_db
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Comma-separated origins allowed to call the API (Flutter web/dev server)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# 'mock' for development (no hardware) | 'zk' for a real ZKTeco unit
BIOMETRIC_DEVICE_BACKEND=mock
ZK_DEVICE_IP=192.168.1.201
ZK_DEVICE_PORT=4370
ZK_DEVICE_TIMEOUT=10

# Password for the seeded 'admin' superuser (change this)
ADMIN_PASSWORD=change-me

# --- Phase 2 ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
SYNC_INTERVAL_MINUTES=5

# Firebase service account JSON (path). Leave blank to disable actual sending.
FIREBASE_CREDENTIALS=
