# ---------------------------------------------------------------------------
# Docker environment. Inside the compose network, hosts are SERVICE NAMES
# (db, redis, web, nginx) — not 127.0.0.1. Loaded via `env_file: .env.docker`.
#
# Copy this to `.env.docker` and fill in real values before deploying anywhere
# that isn't your own machine — `.env.docker` itself is gitignored.
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEBUG=True
# Add your host LAN IP here so the Flutter app can reach the backend, e.g. 192.168.1.10
# .trycloudflare.com / .ngrok-free.app / .ngrok-free.dev (leading dot) match
# either tunnel's subdomain.
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx,.trycloudflare.com,.ngrok-free.app,.ngrok-free.dev
# Lets the CSRF-protected admin portal work over the HTTPS tunnel.
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com,https://*.ngrok-free.app,https://*.ngrok-free.dev,http://localhost,http://127.0.0.1

# --- ngrok (free static domain — fixed across restarts, no rate-limit
# surprises like the anonymous Cloudflare Quick Tunnel below). Get the
# authtoken from https://dashboard.ngrok.com/get-started/your-authtoken and
# the domain from Universal Gateway -> Domains (auto-assigned on signup).
NGROK_AUTHTOKEN=change-me
NGROK_STATIC_DOMAIN=change-me.ngrok-free.dev

# --- MySQL ---
# The mysql:8 image reads MYSQL_* to bootstrap; Django reads DB_* to connect.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=attendance_db
DB_NAME=attendance_db
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# --- Celery / Redis (Redis is now a container — no Memurai/WSL needed) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SYNC_INTERVAL_MINUTES=5

# --- Biometric device ---
# 'mock' for development (no hardware) | 'zk' for a real ZKTeco unit
BIOMETRIC_DEVICE_BACKEND=mock
ZK_DEVICE_IP=192.168.1.201
ZK_DEVICE_PORT=4370
ZK_DEVICE_TIMEOUT=10

# --- Firebase (blank => FCM disabled, system still runs) ---
# In-container path; the dev bind mount exposes ./secrets/ at /app/secrets/.
FIREBASE_CREDENTIALS=/app/secrets/firebase-service-account.json

# CORS: nginx serves the portal on http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# Public (no-login) live-logs kiosk at /live/. False => page returns 404.
# WARNING: over the Cloudflare tunnel this exposes employee names publicly.
LIVE_LOGS_PUBLIC=True

# --- Startup behaviour (consumed by entrypoint.sh) ---
SEED_ON_START=true
COLLECT_STATIC=true

# Seeded admin password (printed by seed_data) — change this
ADMIN_PASSWORD=change-me
